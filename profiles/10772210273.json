{"u": "10772210273", "name": "Into The Hive", "place": "127112779460977", "created": "2026-10-21", "updated": "2026-11-18T16:34:33.95Z", "genre": "Shooter", "subgenre": "PvE Shooter", "desc": "The deeper you go, the more you awake.\n\nInto The Hive is a co-op shooter for 1–4 players. Explore sprawling randomly generated caves, fight through insect swarms, and complete your mission before making the run back to extraction.\n\nChoose your weapons, bring the right tools, and carve your own path through destructible terrain. Deploy a turret to cover your squad, break through a wall to open a route, or hold your ground when the swarm closes in.\n\nBack at base, customize your equipment with Augments and prepare for the next expedition. Every loadout gives you a different way to take on the hive.\n\nGo in alone or bring friends. Keep an eye on the ceiling.", "desc_hash": "0c9cf6746cdb", "max_players": 32, "vip": false, "price": null, "avatar": "MorphToR15", "visits": 7291177, "favorites": 146942, "creator": {"id": 195582022, "name": "To The Earth's Core", "type": "Group", "verified": false}, "daily": {"2026-11-16": {"updated": "2026-11-16T06:05:54.16Z", "visits": 5611904, "fav": 117847, "up": 5906, "down": 447}, "2026-11-17": {"updated": "2026-11-17T09:54:15.986Z", "visits": 6417471, "fav": 131278, "up": 6688, "down": 498}, "2026-11-18": {"updated": "2026-11-18T16:34:33.95Z", "visits": 7291177, "fav": 146942, "up": 7454, "down": 560}}, "passes": [{"name": "Phoenix Armor", "price": 799}, {"name": "VIP", "price": 199}, {"name": "Mastery Booster", "price": 199}, {"name": "Tech Viking", "price": 399}, {"name": "Tech Ninja", "price": 399}], "products": [{"name": "Weapon Unlock (Tier 1)", "price": 119}, {"name": "Weapon Unlock (Tier 2)", "price": 219}, {"name": "Weapon Unlock (Tier 3)", "price": 349}, {"name": "Premium Weapon Crate", "price": 69}, {"name": "Premium Utility Crate", "price": 49}, {"name": "Premium Throwable Crate", "price": 49}, {"name": "10x Premium Weapon Crate