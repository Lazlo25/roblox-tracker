{"u": "10770197883", "name": "🎬 Make a Cartoon!", "place": "139611482808453", "created": "2026-10-10", "updated": "2026-11-03T22:29:45.258Z", "genre": "Party & Casual", "subgenre": "Coloring & Drawing", "desc": "🎬 Welcome to Make a Cartoon! ✏️\n\n✏️ Draw, animate and share your own cartoons!\n👍 Like the game and join our group!\n\n🎮 How to Play\n\n➡️ Create a new cartoon\n➡️ Add stickmen, animals, props and effects\n➡️ Drag their joints to pose them\n➡️ Add a new frame and move them a little\n➡️ Press Play and watch them move!\n➡️ Share your cartoon in the Gallery\n\n✅ That's it, now you know how to play!\n\n✨ Things to look for!\n\n✏️ Free drawing with any color and brush size\n🎨 Color picker to grab any color from your scene\n💬 Speech bubbles to make your characters talk\n🎥 Camera moves and zooms\n🏙️ Lots of scenes: City, Beach, Space, Night\n❤️ Like the best cartoons and reach the Top!\n💾 Your cartoons are saved automatically\n\n💻 Supports desktop, mobile, tablet, and console! 📱\n\n❤️Like the game, add it to your favorites and spend some time playing!\n\n🛡️ We moderate content to ensure it adheres to Roblox Community Standards. See something off? Use the Report button!", "desc_hash": "a0efcd3612a7", "max_players": 30, "vip": false, "price": null, "avatar": "MorphToR15", "visits": 5616449, "favorites": 25647, "creator": {"id": 592529142, "name": "Original efforts", "type": "Group", "verified": false}, "daily": {"2026-11-01": {"updated": "2026-11-01T12:44:07.721Z", "visits": 2147525, "fav": 11783, "up": 2194, "down": 884}, "2026-11-02": {"updated": "2026-11-02T14:27:36.001Z", "visits": 3558254, "fav": 17680, "up": 3356, "down": 1435}, "2026-11-03": {"updated": "2026-11-02T14:27:36.001Z", "visits": 4631203, "fav": 22157, "up": 4181, "down": 1790}, "2026-11-04": {"updated": "2026-11-03T22:29:45.258Z", "visits": 5616449, "fav": 25647, "up": 4905, "down": 2018}}, "passes": [], "products": [{"name": "VIP", "price": 249}, {"name": "Stick Moves Pack", "price": 129}, {"nam